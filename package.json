{
  "name": "siftql-demo",
  "version": "0.0.0",
  "private": true,
  "description": "A demo of @siftql/core computing highlight ranges and @siftql/react-highlighter painting them.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
